{
  "design_tokens_version": "0.1.0",
  "brand": {
    "name": "Open Matchday",
    "identity": "pitch-side control room",
    "summary": "Precise sports-broadcast UI: turf chrome, chalk type, amber callouts, red reserved for on-air tally."
  },
  "spacing": {
    "unit_px": 8,
    "scale_px": [4, 8, 16, 24, 32, 48, 64]
  },
  "typography": {
    "display_family": "ui-sans-serif, \"Segoe UI\", \"Helvetica Neue\", sans-serif",
    "body_family": "ui-sans-serif, \"Segoe UI\", \"Helvetica Neue\", sans-serif",
    "mono_family": "ui-monospace, \"Cascadia Code\", Consolas, monospace",
    "display_tracking_em": -0.03,
    "tally_tracking_em": 0.12,
    "scale_px": {
      "xs": 12,
      "sm": 14,
      "base": 16,
      "lg": 18,
      "xl": 20,
      "2xl": 24,
      "3xl": 30,
      "4xl": 36
    },
    "note": "Generic stacks only until a redistributable font license is cited under fonts/."
  },
  "director": {
    "bg": "#0F1412",
    "surface": "#13261F",
    "surface_raised": "#1A2A22",
    "border": "#2A3832",
    "border_active": "#3D8B6E",
    "text": "#E8EDE9",
    "text_muted": "#9BB0A4",
    "accent": "#3D8B6E",
    "accent_pressed": "#2F6B55",
    "warning": "#E8C547",
    "danger": "#8B3D3D",
    "focus_ring": "#7EC8A8"
  },
  "camera_daylight": {
    "bg": "#DDE6E0",
    "surface": "#F2F5F3",
    "surface_raised": "#FFFFFF",
    "border": "#A8B8B0",
    "border_active": "#1B4D3E",
    "text": "#1A2420",
    "text_muted": "#4A5C54",
    "accent": "#1B4D3E",
    "accent_pressed": "#143B30",
    "warning": "#8A6B12",
    "danger": "#8B3D3D",
    "focus_ring": "#1B4D3E"
  },
  "tally": {
    "on_air_bg": "#B00020",
    "on_air_border": "#FF4D4D",
    "on_air_text": "#FFFFFF",
    "off_bg": "#1A2420",
    "off_border": "#2A3832",
    "off_text": "#9BB0A4",
    "min_height_px": 88,
    "label_on": "ON AIR",
    "label_off": "TALLY OFF"
  },
  "semantic": {
    "success": "#2F6B55",
    "info": "#3D6B8B"
  },
  "contrast_pairs": [
    { "fg": "director.text", "bg": "director.bg", "min_ratio": 4.5 },
    { "fg": "director.text", "bg": "director.surface", "min_ratio": 4.5 },
    { "fg": "director.text_muted", "bg": "director.bg", "min_ratio": 4.5 },
    { "fg": "camera_daylight.text", "bg": "camera_daylight.bg", "min_ratio": 4.5 },
    { "fg": "camera_daylight.text", "bg": "camera_daylight.surface", "min_ratio": 4.5 },
    { "fg": "camera_daylight.text_muted", "bg": "camera_daylight.surface", "min_ratio": 4.5 },
    { "fg": "tally.on_air_text", "bg": "tally.on_air_bg", "min_ratio": 4.5 },
    { "fg": "tally.off_text", "bg": "tally.off_bg", "min_ratio": 4.5 }
  ],
  "banned": {
    "notes": [
      "No purple gradients",
      "No blobs as primary decoration",
      "No glassmorphism",
      "No stock clutter",
      "No fake numbers or engagement metrics",
      "No copied broadcaster looks",
      "No emoji",
      "Red reserved for on-air tally (and explicit danger), never decoration"
    ]
  },
  "sources": [
    "PROJECT_SPEC.md AC-12.1",
    "WCAG 2.2 SC 1.4.3 https://www.w3.org/TR/WCAG22/#contrast-minimum"
  ]
}
